  },
  "radius": {
    "base": { "value": "0.625rem", "type": "dimension", "description": "10px — shadcn radius token" },
    "sm": { "value": "calc(var(--radius) * 0.6)", "type": "dimension", "description": "6px" },
    "md": { "value": "calc(var(--radius) * 0.8)", "type": "dimension", "description": "8px" },
    "lg": { "value": "0.625rem", "type": "dimension", "description": "10px" },
    "xl": { "value": "calc(var(--radius) * 1.4)", "type": "dimension", "description": "14px" },
    "2xl": { "value": "calc(var(--radius) * 1.8)", "type": "dimension", "description": "18px" },
    "3xl": { "value": "calc(var(--radius) * 2.2)", "type": "dimension", "description": "22px" },
    "4xl": { "value": "calc(var(--radius) * 2.6)", "type": "dimension", "description": "26px" },
    "full": { "value": "9999px", "type": "dimension", "description": "Used for nav pill and avatar-ish shapes" }
