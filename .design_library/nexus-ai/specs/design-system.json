      "wrapper": "absolute inset-0 z-0 pointer-events-none",
      "selector": ".pixel-canvas-fade (opacity 0.35, fade-in 1.2s)",
      "animation": "pulse — radial wave expand→contract→expand, floor at 25% maxSize"
    }
